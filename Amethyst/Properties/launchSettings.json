{
  "profiles": {
    "Amethyst": {
      "commandName": "Project",
      "commandLineArgs": "compile examples/test.ame --dump-ir -c -o output.zip --run",
      "workingDirectory": "$(ProjectDir)"
    },
    "Shard": {
      "commandName": "Project",
      "commandLineArgs": "build -f examples/shard/shard.json --run",
      "workingDirectory": "$(ProjectDir)"
    },
    "Test Suite": {
      "commandName": "Project",
      "commandLineArgs": "compile tests/*.ame -o output.zip --run",
      "workingDirectory": "$(ProjectDir)"
    },
    "Amethyst Random": {
      "commandName": "Project",
      "commandLineArgs": "setup --eula",
      "workingDirectory": "$(ProjectDir)"
    }
  }
}