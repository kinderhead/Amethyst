{
  "profiles": {
    "Amethyst": {
      "commandName": "Project",
      "commandLineArgs": "compile examples/test.ame -c -o output.zip -L testlib.zip --run",
      "workingDirectory": "$(ProjectDir)"
    },
    "Shard": {
      "commandName": "Project",
      "commandLineArgs": "build -f examples/shard/shard.json --run",
      "workingDirectory": "$(ProjectDir)"
    },
    "Test Suite": {
      "commandName": "Project",
      "commandLineArgs": "compile tests/*.ame -I lib.zip -o output.zip --run",
      "workingDirectory": "$(ProjectDir)"
    },
    "Test Suite Lib": {
      "commandName": "Project",
      "commandLineArgs": "compile tests/linking/lib.ame -o lib.zip",
      "workingDirectory": "$(ProjectDir)"
    },
    "Random": {
      "commandName": "Project",
      "commandLineArgs": "cluster add -s examples/shard/shard.json -v 1.1 yay",
      "workingDirectory": "$(ProjectDir)"
    }
  }
}