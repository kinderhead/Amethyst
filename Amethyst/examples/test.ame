entitydef minecraft:sheep implements minecraft:base {
    float Health;
}

int add(macro int arg) {
    return arg + 7;
}

struct foo {

    int[] elements;

    foo() {
        this.elements = [0];
    }

    void bar(int value) {
        this.elements[0] = value;
    }
}


#load
void main() {
    foo x = foo();
    x.bar(50);
    print(x.elements);

    amethyst:exit();
}

