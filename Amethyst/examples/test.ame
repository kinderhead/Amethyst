// Rolling test file. Feel free to edit when testing forks. Any changes to this file in a PR will likely be accepted.

namespace example;

int x = 0;
int y = 0;

struct mystruct {
    int x;

    void foo() {
        x = 5;
    }
}

class myclass {
    int y;

    void bar() {
        y = 15;
    }
}

#load
void main() {
 
    mystruct a;
    myclass b;

    a.foo();
    b.bar();

    print(x);   // global x = 0
    print(a.x); // property x = 5
    print(y);   // global y = 0
    print(b.y); // property y = 15

    amethyst:exit();
}
