namespace test;

#test
void test_int_add() {
    start("int add");

    int x = 5;
    int y = x + 70;

    assert_eq(y, 75);

    complete();
}

#test
void test_int_sub() {
    start("int sub");

    int x = 5;
    int y = 70 - x;

    assert_eq(y, 65);
    
    complete();
}

#test
void test_int_mul() {
    start("int mul");

    int x = 5;
    int y = 6 * x;

    assert_eq(y, 30);
    
    complete();
}

#test
void test_int_div() {
    start("int div");

    int x = 100;
    int y = x / 4;

    assert_eq(y, 25);
    
    complete();
}

#test
void test_int_mod() {
    start("int mod");

    int x = 8;
    int y = x % 7;

    assert_eq(y, 1);
    
    complete();
}

#test
void test_int_big_math() {
    start("int big math");

    int a = 4;
    int b = 2;
    int c = 10;
    int d = 3;

    int ret = a + b - 10 * c / d + 80 - a * b;
    assert_eq(ret, 45); // I think scoreboard division floors while C truncates
    
    complete();
}

#test
void test_int_assign_math() {
    start("int assign math");

    int x = 5;

    x += 10;
    assert_eq(x, 15);

    x -= 12;
    assert_eq(x, 3);

    x *= -6;
    assert_eq(x, -18);

    x /= 2;
    assert_eq(x, -9);

    x %= 3;
    assert_eq(x, 0);
    
    complete();
}

#test
void test_int_inc() {
    start("int increment");

    int x = 5;
    assert_eq(++x, 6);
    
    complete();
}

#test
void test_int_dec() {
    start("int decrement");

    int x = -5;
    assert_eq(--x, -6);
    
    complete();
}

#test
void test_int_negate() {
    start("int negate");

    int x = 5;
    assert_eq(-x, -5);

    x = -9;
    assert_eq(-x, 9);
    
    complete();
}

#test
#[>=121.0]
void test_float_add() {
    start("float add");

    float x = 5.3;
    float y = x + 70.2;

    assert_eq(y, 75.5);

    complete();
}

#test
#[>=121.0]
void test_float_sub() {
    start("float sub");

    float x = 5.2;
    float y = 70.5 - x;

    assert_eq(y, 65.3);
    
    complete();
}

#test
#[>=121.0]
void test_float_mul() {
    start("float mul");

    float x = 5.2;
    float y = 6.65 * x;

    assert_eq(y, 34.579998);
    
    complete();
}

#test
#[>=121.0]
void test_float_div() {
    start("float div");

    float x = 100.321;
    float y = x / 4.9;

    assert_eq(y, 20.4736734694);
    
    complete();
}

#test
#[>=121.0]
void test_float_big_math() {
    start("float big math");

    float a = 4.43;
    float b = 2.1123;
    float c = 10.432;
    float d = -3.432;

    float ret = a + b - 10 * c / d + 80 - a * b;
    assert_eq(ret, 107.58108);
    
    complete();
}

#test
#[>=121.0]
void test_float_assign_math() {
    start("float assign math");

    float x = 5;

    x += 10.1;
    assert_eq(x, 15.1);

    x -= 12.2;
    assert_eq(x, 2.9000006);

    x *= -6;
    assert_eq(x, -17.400003);

    x /= 2;
    assert_eq(x, -8.700002);
    
    complete();
}

#test
#[>=121.0]
void test_float_negate() {
    start("float negate");

    float x = 5.4;
    assert_eq(-x, -5.4);

    x = -9.87;
    assert_eq(-x, 9.87);
    
    complete();
}


#test
#[>=121.0]
void test_math_intrinsics() {
    start("math intrinsics");

    float x = 2f;
    assert_eq(math/pow(2f, 3), 8f);
    x = 1.5f;
    assert_eq(math/pow(1.5f, 2.5f), 2.755676f);

    x = 64f;
    assert_eq(math/sqrt(x), 8f);
    x = 32f;
    assert_eq(math/sqrt(x), 5.656854f);
    
    x = 1f;
    assert_eq(math/sin(x), 0.8414514f);
    assert_eq(math/cos(x), 0.54033285f);

    x = 2f;
    assert_eq(math/sin(x), 0.9093276f);
    assert_eq(math/cos(x), -0.41608086f);
    
    x = 1.5f;
    assert_eq(math/round(x), 2f); 
    x = 1.49f;
    assert_eq(math/round(x), 1f); 
    
    x = 2.75f;
    assert_eq(math/floor(x), 2f);
    assert_eq(math/floor(-x), -3f);
    assert_eq(math/ceil(x), 3f);
    assert_eq(math/ceil(-x), -2f);
    
    x = 100.5f;
    assert_eq(math/trunc(x), 100f);
    assert_eq(math/trunc(-x), -100f);

    complete();
}