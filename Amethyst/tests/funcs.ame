namespace test;

#test
void test_inline_simple() {
    start("inline simple");

    int x = 2;
    assert_eq(x, 2);
    simple_inline();
    assert_eq(x, 2);

    complete();
}

#test
void test_macro_propagation() {
    start("macro propagation");
    
    assert_eq(propagate(2), 1);
    assert_eq(propagate(-3), -6);

    complete();
}

#test
void test_overload() {
    start("overload");
    
    assert_eq(overload_test(), 234);
    assert_eq(overload_test(5), 5);
    assert_eq(overload_test(7s), 14);
    assert_eq(overload_test("hi"), 7);

    complete();
}

#test
void test_dyn_func() {
    start("dyn func");
    
    var func = bool_pass;

    assert(func(true));
    assert(!func(false));

    complete();
}

#test
void test_dyn_macro_func() {
    start("dyn macro func");
    
    var func = macro_bool_pass;

    assert(func(true));
    assert(!func(false));

    complete();
}

#test
void test_dyn_func_passthrough() {
    start("dyn func passthrough");
    
    assert(bool_layer(bool_pass, true));
    assert(!bool_layer(bool_pass, false));

    complete();
}

bool bool_pass(bool val) {
    return val;
}

bool macro_bool_pass(macro bool val) {
    return val;
}

bool bool_layer(bool(bool) func, bool arg) {
    return func(arg);
}

inline void simple_inline() {
    int x = 7;
    assert_eq(x, 7);
}

int propagate(macro int x) {
    if (x < 0) {
        return x * 2;
    } else {
        return x - 1;
    }

    return 0; // I'll have to make it smarter at some point
}

int overload_test() {
    return 234;
}

int overload_test(int x) {
    return x;
}

int overload_test(short x) {
    return x * 2;
}

int overload_test(string str) {
    return 7;
}
