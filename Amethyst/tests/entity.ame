namespace test;

#test
void test_entity_exists() {
    start("entity exists");

    kill(@e[type="wither"]);
    
    macro_entity_tester(false);
    assert(!@e[type="wither"]);

    summon("wither");

    macro_entity_tester(true);
    assert(@e[type="wither"]);

    kill(@e[type="wither"]);

    macro_entity_tester(false);
    assert(!@e[type="wither"]);

    complete();
}

void macro_entity_tester(macro bool x) {
    qstring type = "wither";

    if (@e[type=type]) {
        assert(x);
    } else {
        assert(!x);
    }
}

#test
void test_entity_negate() {
    start("entity negate");

    kill(@e[type="wither"]);
    @/summon wither ~ ~ ~ { CustomName: "womp1" }
    @/summon wither ~ ~ ~ { CustomName: "womp2" }

    assert(!@e[type="wither",name=!"womp1",name=!"womp2"]);

    summon("wither");

    assert(@e[type="wither",name=!"womp1",name=!"womp2"]);

    kill(@e[type="wither"]);

    complete();
}

#test
void test_entity_tag() {
    start("entity tag");

    kill(@e[type="wither"]);
    
    unsafe_string tag = "womp";

    summon("wither");
    @/tag @e[type=wither] add $(tag)
    
    assert(@e[tag=tag]);

    kill(@e[type="wither"]);

    complete();
}

#test
void test_entity_ref() {
    start("entity ref");

    kill(@e[type="wither"]);
    summon("wither");
    
    test_entity e = @e[type="wither", limit=1];
    
    assert(!e.Invulnerable);
    e.Invulnerable = true;
    assert(e.Invulnerable);

    kill(@e[type="wither"]);

    complete();
}

#test
void test_entity_ref_equals() {
    start("entity ref equals");

    kill(@e[type="wither"]);
    summon("wither");
    
    test_entity e1 = @e[type="wither", limit=1];
    test_entity e2 = @e[type="wither", limit=1];
    
    assert(e1 == e2);

    kill(@e[type="wither"]);

    complete();
}

#test
void test_entity_ref_ref() {
    start("entity ref ref");

    kill(@e[type="wither"]);
    summon("wither");
    
    test_entity e = @e[type="wither", limit=1];
    test_entity^ ptr = e;

    assert(!ptr.Invulnerable);
    ptr.Invulnerable = true;
    assert(ptr.Invulnerable);

    kill(@e[type="wither"]);

    complete();
}

#test
void test_fork_block() {
    start("fork block");

    kill(@e[type="wither"]);
    summon("wither");
    
    int count = 0;
    as (@e[limit=1]) {
        at (@s) {
            assert(true);
        }

        for (int i = 0; i < 5; ++i) {
            assert(i < 5);
        }
        
        ++count;
    }

    assert_eq(count, 1);

    count = 0;
    as (@e[limit=1]) {
        if (true) { 
            assert(true);
        }

        at (@s) {
            assert(true);
        }
        
        ++count;
    }

    assert_eq(count, 1);

    count = 0;
    as (@e[limit=1]) {
        if (true) { 
            assert(true);
        }
        
        ++count;
    }

    assert_eq(count, 1);

    kill(@e[type="wither"]);

    complete();
}

#test
void test_target_literal() {
    start("target literal");

    var test = (string)@e[x=4.3, y=5.3, z=-93, dx=3, dy=-3.2, dz=0, limit=1, name="hi", type="minecraft:sheep", predicate="minecraft:zang", tag="no", team="yes", sort="nearest", gamemode="creative", distance=3.2..8.7, x_rotation=5..7, y_rotation=9..10.2, level=4..5, nbt={x: 4}];
    assert_eq(test, "@e[x=4.3,y=5.3,z=-93,dx=3,dy=-3.2,dz=0,limit=1,name=\"hi\",type=minecraft:sheep,predicate=minecraft:zang,tag=no,team=yes,sort=nearest,gamemode=creative,distance=3.2..8.7,x_rotation=5..7,y_rotation=9..10.2,level=4..5,nbt={\"x\":4}]");

    complete();
}

#test
void test_target_dynamic() {
    start("target literal");

    var x = 4.3;
    var y = 5.3;
    var z = -93;
    var dx = 3;
    var dy = -3.2;
    var dz = 0;
    var limit = 1;
    var type = "minecraft:sheep";
    var predicate = "minecraft:zang";
    unsafe_string tag = "no";
    unsafe_string team = "yes";
    unsafe_string sort = "nearest";
    unsafe_string gamemode = "creative";
    var distance = 3.2..8.7;
    var x_rotation = 5..7;
    var y_rotation = 9..10.2;
    var level = 4..5;

    var test = (string)@e[x=x, y=y, z=z, dx=dx, dy=dy, dz=dz, limit=limit, name=!"hi", type=type, predicate=predicate, tag=tag, team=team, sort=sort, gamemode=gamemode, distance=distance, x_rotation=x_rotation, y_rotation=y_rotation, level=level, nbt=!{x: 4}];
    assert_eq(test, "@e[x=4.3,y=5.3,z=-93,dx=3,dy=-3.2,dz=0,limit=1,name=!\"hi\",type=minecraft:sheep,predicate=minecraft:zang,tag=no,team=yes,sort=nearest,gamemode=creative,distance=3.2..8.7,x_rotation=5..7,y_rotation=9..10.2,level=4..5,nbt=!{\"x\":4}]");

    complete();
}
