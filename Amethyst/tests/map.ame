namespace test;

#test
void test_int_map() {
    start("int map");

    int{} x;
    int y = 6;
    qstring id = "e";

    x["womp"] = 3;
    x[id] = y;

    assert_eq(x["womp"], 3);
    assert_eq(x[id], y);
    
    complete();
}

#test
void test_string_map() {
    start("string map");

    string{} x = { a: "yay", "b b": "yay2" };
    var id = "b b";

    assert_eq(x["a"], "yay");
    assert_eq(x[id], "yay2");
    
    complete();
}